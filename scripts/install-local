#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
source_dir="$root"
target="$HOME/.config/omarchy/plugins/harel.omarchy-synchro"
omarchy plugin validate "$source_dir"
mkdir -p -- "$(dirname -- "$target")"
if [[ -e "$target" && ! -L "$target" ]]; then echo "Refusing to replace non-symlink: $target" >&2; exit 1; fi
ln -sfn -- "$source_dir" "$target"
omarchy-shell shell rescanPlugins
omarchy bar put harel.omarchy-synchro --section right
printf 'Installed harel.omarchy-synchro from %s\n' "$source_dir"
